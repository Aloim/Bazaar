# Vitest-only env (mode "test") — Phase 8 A5 builder-ABI snapshot tests.
# The WTB filler-withdraw loop requires a world package id at module load;
# any 32-byte id works — the tests assert arg SHAPE, not on-chain reality.
VITE_WORLD_PACKAGE_ID=0xeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeee
# Silence the loud missing-original-id console guards in test output.
VITE_ORIGINAL_PACKAGE_ID=0xeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeee01
VITE_BAZAAR_ECONOMY_ORIGINAL_PACKAGE_ID=0xeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeee02
